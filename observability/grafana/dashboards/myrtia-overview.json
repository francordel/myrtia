{
  "uid": "myrtia-overview",
  "title": "Myrtia overview",
  "tags": [
    "myrtia"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Tokens, latency and activity of Myrtia's models and runs, from /metrics.",
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "myrtia-prometheus"
        },
        "query": {
          "query": "label_values(myrtia_run_model_calls_total, run)",
          "refId": "run"
        },
        "refresh": 2,
        "sort": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Now",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Active runs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "myrtia-prometheus"
      },
      "description": "Runs in flight.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "myrtia-prometheus"
          },
          "expr": "sum(myrtia_runs_active) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Finished runs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "myrtia-prometheus"
      },
      "description": "Since Myrtia started.",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "myrtia-prometheus"
          },
          "expr": "sum(myrtia_runs_finished_total) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Model calls",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "myrtia-prometheus"
      },
      "description": "Since Myrtia started.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "myrtia-prometheus"
          },
          "expr": "sum(myrtia_model_calls_total) or vector(0)",
